{
  "name": "@visual-resumes/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . && cd ../shared && eslint .",
    "test": "node --test 'api/**/*.test.js' 'image-resizer/**/*.test.js' 'renderer/**/*.test.js' '../shared/**/*.test.js'",
    "build": "yarn build:api && yarn build:image-resizer && yarn build:renderer",
    "build:api": "api/scripts/build.sh",
    "build:image-resizer": "image-resizer/scripts/build.sh",
    "build:renderer": "renderer/scripts/build.sh",
    "push-image-resizer": "image-resizer/scripts/push.sh $(aws sts get-caller-identity --query Account --output text) $(aws configure get region)",
    "push-renderer": "renderer/scripts/push.sh $(aws sts get-caller-identity --query Account --output text) $(aws configure get region)"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.712.0",
    "@aws-sdk/client-s3": "3.712.0",
    "@aws-sdk/s3-request-presigner": "3.712.0",
    "@hono/node-server": "2.0.4",
    "@sparticuz/chromium-min": "143.0.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "hono": "4.12.23",
    "nanoid": "5.0.9",
    "puppeteer-core": "24.34.0",
    "sharp": "0.33.5",
    "ulid": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.24.2",
    "eslint": "9.18.0",
    "globals": "15.14.0"
  }
}
